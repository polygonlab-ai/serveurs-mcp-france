# Fins de ligne normalisées (LF) pour tous les fichiers texte.
* text=auto eol=lf

# Fichiers de développement exclus des paquets installés (seuls data/, schema/, README.md et LICENSE sont livrés).
/.github export-ignore
/tests export-ignore
/examples export-ignore
/tools export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.php-cs-fixer.dist.php export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
/CHANGELOG.md export-ignore

# Fiche du dépôt lue par la commande de publication : jamais publiée.
/depot.json export-ignore
